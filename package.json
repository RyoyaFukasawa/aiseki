{
  "name": "aiseki",
  "version": "0.0.0",
  "description": "A lightweight Model layer for Drizzle ORM.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "pnpm run build && tsc -p tsconfig.examples.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/adapter/drizzle/index.d.ts",
      "import": "./dist/adapter/drizzle/index.js"
    }
  },
  "files": ["dist"],
  "packageManager": "pnpm@10.26.0",
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
