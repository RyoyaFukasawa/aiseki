{
  "name": "aiseki",
  "version": "0.0.0",
  "description": "A TypeScript ORM where objects and relational data share a table.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "aiseki": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/drivers/d1/index.d.ts",
      "import": "./dist/drivers/d1/index.js"
    },
    "./better-sqlite3": {
      "types": "./dist/drivers/better-sqlite3/index.d.ts",
      "import": "./dist/drivers/better-sqlite3/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "aiseki": "./bin/aiseki.mjs"
  },
  "packageManager": "pnpm@10.26.0",
  "peerDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
